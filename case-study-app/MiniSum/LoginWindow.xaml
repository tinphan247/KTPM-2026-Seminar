<Window x:Class="MiniSum.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniSum - Dang nhap" Height="340" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F5F5F5"
        AutomationProperties.AutomationId="winLogin">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="MINISUM - DANG NHAP"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   AutomationProperties.AutomationId="lblTitle"/>

        <TextBlock Grid.Row="2" Text="Tai khoan:" FontSize="14"
                   AutomationProperties.AutomationId="lblUser"/>
        <TextBox Grid.Row="4" x:Name="txtUser"
                 AutomationProperties.AutomationId="txtUser"
                 FontSize="14" Padding="6,4"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Text="Mat khau:" FontSize="14"
                   AutomationProperties.AutomationId="lblPass"/>
        <PasswordBox Grid.Row="8" x:Name="txtPass"
                     AutomationProperties.AutomationId="txtPass"
                     FontSize="14" Padding="6,4"
                     VerticalContentAlignment="Center"
                     PasswordChar="*"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button x:Name="btnSubmit"
                    AutomationProperties.AutomationId="btnSubmit"
                    Content="DANG NHAP"
                    Width="140" Height="36"
                    FontSize="14" FontWeight="Bold"
                    Click="BtnSubmit_Click"/>
        </StackPanel>

        <TextBlock x:Name="lblMessage"
                   AutomationProperties.AutomationId="lblMessage"
                   Grid.Row="12" FontSize="14"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0"
                   Grid.RowSpan="2"/>
    </Grid>
</Window>
