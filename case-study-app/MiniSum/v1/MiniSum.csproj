<Project Sdk="Microsoft.NET.Sdk">

  <!-- MiniSum v1 - Ban goc: Login (admin/1234) + Calculator (A + B), chua co validation -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MiniSum</AssemblyName>
    <RootNamespace>MiniSum</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <Product>MiniSum v1</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs" Exclude="..\src\HistoryForm.cs;..\src\CalculationHistory.cs" LinkBase="src" />
  </ItemGroup>

</Project>
